          "type": "boolean"
        },
        "alertTargetClass": {
          "type": "string",
          "maxLength": 80
        },
        "alertMinConfidence": {
          "type": "number"
        },
        "customIconDataUrl": {
          "type": "string",
          "maxLength": 150000
        },
        "status": {
          "type": "string",
          "enum": ["draft", "ready", "published"]
        },
        "version": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "projectId",
        "modelId",
        "modelName",
        "ownerUid",
        "taskType",
        "name",
        "shortName",
        "description",
        "tier",
        "themeColor",
        "backgroundColor",
        "runtimeTarget",
        "inputSources",
        "confidenceThreshold",
        "iouThreshold",
        "showConfidence",
        "showLatency",
        "showHistory",
        "allowCsvExport",
        "customHeaderTitle",
        "alertEnabled",
        "alertTargetClass",
        "alertMinConfidence",
        "customIconDataUrl",
        "status",
        "version",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and preferences isolated strictly to the owning user."
    },
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "Personal and team workspaces owned by authenticated users."
    },
    "/workspaces/{workspaceId}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/WorkspaceMember" },
      "description": "Workspace RBAC membership documents controlled by the workspace owner."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Computer Vision projects belonging to a workspace and user."
    },
    "/datasets/{datasetId}": {
      "schema": { "$ref": "#/entities/Dataset" },
      "description": "Project datasets containing classes, split ratios, and augmentation configurations."
    },
    "/datasets/{datasetId}/items/{itemId}": {
      "schema": { "$ref": "#/entities/DatasetItem" },
      "description": "Individual dataset image metadata, hashes, split assignment, and bounding-box/class annotations."
    },
    "/trainingRuns/{runId}": {
      "schema": { "$ref": "#/entities/TrainingRun" },
      "description": "AI model training job configurations, status, and epoch metric history."
    },
    "/trainedModels/{modelId}": {
      "schema": { "$ref": "#/entities/TrainedModel" },
      "description": "Trained model evaluation summaries, confusion matrices, and runtime compatibility metadata."
    },
    "/evaluationReports/{reportId}": {
      "schema": { "$ref": "#/entities/EvaluationReport" },
      "description": "Immutable evaluation snapshots recording test-split benchmarks and confusion matrices."
    },
    "/generatedApps/{appId}": {
      "schema": { "$ref": "#/entities/GeneratedApp" },
      "description": "User-built standalone Vision PWA configurations generated in MK App Builder."
    },
    "/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Append-only user activity audit log entries."
    }
  }
}
