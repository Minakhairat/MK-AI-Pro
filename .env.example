# ==============================================================================
# MK AI — Environment Configuration Template
# Default development uses local filesystem storage with zero cloud credentials.
# ==============================================================================

PORT=3000
NODE_ENV=development

# Active storage provider: local | s3 | gcs
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.mk_ai_storage

# Compute orchestration metadata: local | gcp | aws
CLOUD_PROVIDER=local
AI_ENGINE_URL=

# ------------------------------------------------------------------------------
# Google Cloud Storage (ONLY required when STORAGE_PROVIDER=gcs)
# ------------------------------------------------------------------------------
# CLOUD_REGION=europe-west3
# GCS_BUCKET=mk-ai-production-datasets
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ------------------------------------------------------------------------------
# S3-Compatible Storage / MinIO (ONLY required when STORAGE_PROVIDER=s3)
# ------------------------------------------------------------------------------
# S3_BUCKET=mk-ai-datasets
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=