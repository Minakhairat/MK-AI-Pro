# GEMINI_API_KEY: Optional for future AI-assisted metadata/documentation features.
# AI Studio injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PORT: Server listening port (must be 3000 in AI Studio preview).
PORT="3000"

# AI_ENGINE_URL: URL of the independent Python FastAPI AI Training Engine.
# Leave empty if the Python engine is not running in the current environment.
AI_ENGINE_URL="http://localhost:8000"

# CLOUD_PROVIDER: Multi-cloud adapter selection ('gcp' | 'aws' | 'local').
CLOUD_PROVIDER="gcp"

# STORAGE_PROVIDER: Object storage adapter ('local' | 's3' | 'gcs').
STORAGE_PROVIDER="local"

# S3_BUCKET / S3_ENDPOINT / S3_REGION: S3-compatible object storage settings (backend only).
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION=""
