        "preferredTheme": {
          "type": "string",
          "enum": ["light", "dark"]
        },
        "planTier": {
          "type": "string",
          "enum": ["free", "pro", "enterprise"]
        },
        "storageUsedBytes": {
          "type": "number"
        },
        "storageQuotaBytes": {
          "type": "number"
        },
        "cloudCreditsBalance": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
